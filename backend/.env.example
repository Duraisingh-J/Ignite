# --- Server ---
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
# Either set DATABASE_URL, or the discrete PG* vars below (DATABASE_URL wins).
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/leave_management
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD_HERE
PGDATABASE=leave_management

# Connection pool sizing (scalability knobs).
PG_POOL_MIN=1
PG_POOL_MAX=10
