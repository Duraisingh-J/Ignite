classDiagram
    %% ==================== ONBOARDING -> SUBMISSION -> APPROVAL MODEL ====================
    %% Kept in step with backend/app/db/schema.sql. Update both together.
    %%
    %% Scope now covered: an employee sees a region-scoped leave type dropdown,
    %% submits a request, and it runs through a MULTI-TIER approval chain that is
    %% resolved from the reporting line and frozen at submit. Weekends and region
    %% holidays are excluded from the chargeable day count.
    %%
    %% Still out of scope: balances/accrual, authentication, half-days,
    %% role-based approvers (HR/Finance), parallel approvals, SLA escalation.

    class Tenant {
        +UUID id
        +String orgName
    }

    class Region {
        +UUID id
        +UUID tenantId
        +String code
        +String countryName
        +Int[] workDays
        +String timezone
        +isWorkingDay(date) Boolean
    }

    class HolidayCalendar {
        +UUID id
        +UUID tenantId
        +UUID regionId
        +Date date
        +String name
        +Recurrence recurrence
        +occurrencesInRange(start, end) List~Date~
    }

    class Employee {
        +UUID id
        +UUID tenantId
        +UUID managerId
        +UUID regionId
        +String name
        +String email
        +Date joinDate
        +getTeam(managerId, onDate) List~Employee~
        +reassignManager(managerId) void
    }

    class LeaveType {
        +UUID id
        +UUID regionId
        +String name
        +Boolean isPaid
        +Boolean isActive
        +Boolean requiresApproval
        +Int approvalLevels
        +Int escalateAboveDays
        +getDropdownOptions(regionId) List~LeaveType~
        +requiredLevels(chargeableDays) Int
    }

    class LeaveRequest {
        +UUID id
        +UUID tenantId
        +UUID employeeId
        +UUID leaveTypeId
        +Date startDate
        +Date endDate
        +LeaveStatus status
        +String reason
        +DateTime submittedAt
        +submit() void
        +decide(status) void
    }

    class LeaveRequestApproval {
        +UUID id
        +UUID leaveRequestId
        +Int stepOrder
        +UUID approverId
        +ApproverRole approverRole
        +ApprovalStepStatus status
        +String comment
        +DateTime decidedAt
        +decide(approverId, approve, comment) void
    }

    class ApprovalResolver {
        <<service>>
        +requiredLevels(leaveType, chargeableDays) Int
        +resolveApprovers(employeeId, levels) List~UUID~
        +buildChain(leaveRequestId, employeeId, leaveType, days) List~LeaveRequestApproval~
        +deriveRequestStatus(leaveRequestId) LeaveStatus
    }

    class ApproverRole {
        <<enumeration>>
        MANAGER
        SKIP_LEVEL
        DEPT_HEAD
    }

    class ApprovalStepStatus {
        <<enumeration>>
        PENDING
        APPROVED
        REJECTED
        SKIPPED
    }

    class DayBreakdown {
        <<value object>>
        +Int calendarDays
        +Int weekendDays
        +Int holidayDays
        +Int chargeableDays
        +List~Date~ excludedDates
    }

    class WorkingDayCalculator {
        <<service>>
        +calcWorkingDays(start, end, holidays, workDays) DayBreakdown
    }

    class LeaveStatus {
        <<enumeration>>
        PENDING
        APPROVED
        REJECTED
        CANCELLED
    }

    class Recurrence {
        <<enumeration>>
        NONE
        ANNUAL
    }

    class AdminDashboard {
        <<service>>
        +getPendingRequests(tenantId) List~LeaveRequest~
        +getRequestsByEmployee(employeeId) List~LeaveRequest~
        +getApprovalsForManager(managerId) List~LeaveRequest~
        +getTenantStats(tenantId) Stats
    }

    %% ==================== RELATIONSHIPS ====================
    Tenant "1" --> "*" Employee : owns
    Tenant "1" --> "*" LeaveRequest : owns
    Tenant "1" --> "*" Region : defines
    Tenant "1" --> "*" HolidayCalendar : owns

    Employee "*" --> "1" Region : located_in
    Employee "1" --> "*" LeaveRequest : submits
    Employee "*" --> "0..1" Employee : reports_to

    Region "1" --> "*" HolidayCalendar : defines
    Region "1" --> "*" LeaveType : scoped_to
    LeaveRequest "*" --> "1" LeaveType : selected_from_dropdown
    LeaveType ..> LeaveRequest : populates_region_scoped_dropdown

    LeaveRequest ..> HolidayCalendar : excludes_dates_via_region
    LeaveRequest ..> WorkingDayCalculator : computes_day_count
    WorkingDayCalculator ..> Region : reads_workDays
    WorkingDayCalculator ..> DayBreakdown : produces

    LeaveRequest "1" *-- "1..*" LeaveRequestApproval : frozen_chain
    LeaveRequestApproval "*" --> "0..1" Employee : awaiting_decision_from
    LeaveRequest ..> ApprovalResolver : chain_resolved_at_submit
    ApprovalResolver ..> Employee : walks_reporting_line
    ApprovalResolver ..> LeaveType : reads_approvalLevels
    LeaveRequestApproval --> ApproverRole : has
    LeaveRequestApproval --> ApprovalStepStatus : has

    LeaveRequest --> LeaveStatus : has
    HolidayCalendar --> Recurrence : has

    LeaveRequest ..> AdminDashboard : reflected_on_submit
    AdminDashboard ..> Tenant : scoped_to

    %% ==================== NOTES ====================
    %% DayBreakdown is COMPUTED ON READ, not stored. LeaveRequest has no day
    %% column, so editing a holiday calendar retroactively changes the day count
    %% of existing requests. Snapshotting it onto LeaveRequest at submit would
    %% fix that, and is the recommended next schema change.
    %%
    %% Region.workDays holds Python date.weekday() numbers (0=Mon .. 6=Sun).
    %% Mon-Fri in most regions, Sun-Thu across much of the Gulf.
    %%
    %% Recurrence.ANNUAL means the month/day repeats every year and the stored
    %% year is only an anchor. Lunar festivals (Diwali, Eid) follow no formula
    %% and must be entered per year as NONE.
    %%
    %% Employee.reports_to is optional and may cross regions. Cycles and
    %% self-reference are rejected by the service layer, not by the schema.
    %%
    %% ---- Multi-tier approval ----
    %% TWO independent inputs decide a chain:
    %%   WHO approves   -> the employee's own reporting line (per employee)
    %%   HOW MANY tiers -> LeaveType.approvalLevels, plus one when the request
    %%                     exceeds escalateAboveDays. Because LeaveType is
    %%                     already region-scoped, depth is region-specific with
    %%                     no separate policy table.
    %%
    %% The chain is FROZEN as LeaveRequestApproval rows at submit. If the org
    %% chart changes mid-review an in-flight request must not change hands, and
    %% the history has to stay answerable afterwards.
    %%
    %% LeaveRequest.status is DERIVED from the steps and must never be written
    %% directly, or the two can disagree permanently. Any REJECTED step rejects
    %% the request and SKIPs the rest; a step with no reachable approver is
    %% SKIPPED rather than blocking the request forever.
    %%
    %% stepOrder allows duplicates by design, so parallel approvals ("any 2 of
    %% 3") can be added later with a quorum column and no migration.
