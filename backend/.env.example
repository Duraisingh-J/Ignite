# --- Server ---
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
# Either set DATABASE_URL, or the discrete PG* vars below (DATABASE_URL wins).
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/leave_management
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD_HERE
PGDATABASE=leave_management

# Connection pool sizing (scalability knobs).
PG_POOL_MIN=1
PG_POOL_MAX=10

# --- Notifications -------------------------------------------------------
# Where recipients are sent to act. Appears as a link in every message.
APP_BASE_URL=http://localhost:5174

# Master switch. Set false to silence delivery entirely (messages are still
# rendered to the log, so the flow stays observable).
NOTIFICATIONS_ENABLED=true

# Gmail SMTP. SMTP_PASSWORD must be a 16-character App Password generated at
# https://myaccount.google.com/apppasswords with 2-Step Verification enabled.
# Your normal account password will NOT work and Gmail returns a misleading
# error when you try it. There is no separate FROM address: Gmail rewrites a
# mismatched sender to the authenticated account anyway.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional. Requires `pip install slack_sdk` and a bot token with the
# chat:write and users:read.email scopes. Each employee must exist in the
# workspace under the same address held in the employee table, or the DM
# lookup finds nobody and delivery falls through to email.
SLACK_BOT_TOKEN=

# --- Authentication ----------------------------------------------------
# Signing key for tenant-admin JWTs. The app REFUSES TO START if this is
# left at its shipped default. There is no switch to disable authentication.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_TTL_MINUTES=720

